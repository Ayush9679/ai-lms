# Copy to .env and replace every value marked CHANGE_ME.
APP_NAME=AI-LMS
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Local PostgreSQL. docker-compose overrides DATABASE_URL to use the postgres service.
POSTGRES_USER=ailms
POSTGRES_PASSWORD=CHANGE_ME_local_database_password
POSTGRES_DB=ailms_db
DATABASE_URL=postgresql+asyncpg://ailms:CHANGE_ME_local_database_password@localhost:5432/ailms_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_SSL=false
# For Supabase, set DATABASE_SSL=true and point this to its downloaded root CA certificate.
DATABASE_SSL_CA_FILE=

# Generate a signing key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_random_key_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON array of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000"]

# Upload handling
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp","image/gif"]
ALLOWED_VIDEO_TYPES=["video/mp4","video/webm","video/ogg"]
ALLOWED_DOCUMENT_TYPES=["application/pdf"]

# Optional AI integration. Leave empty to disable AI-backed operations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Per-IP limits
RATE_LIMIT_PER_MINUTE=100
AI_RATE_LIMIT_PER_MINUTE=10

# Optional SMTP settings. Email delivery is not implemented yet.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=AI-LMS
